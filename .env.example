# PE Risk Key environment. Copy to .env and fill in.
# Every variable below is read by the code; nothing else is.

# Meta Model API key (https://dev.meta.ai). Required for any model call:
# orchestration, SOC 2 analysis, transcription, claim extraction,
# cross-check, narrative, and public-records search. Missing key fails
# fast with a clear error.
MODEL_API_KEY=

# Per-model-call timeout in seconds (collectors keep their own 10s
# safe_get timeout in net.py).
MODEL_TIMEOUT_SECONDS=300

# Phase-1 input token budget for public-records search per run; further
# queries stop past this (cheapest-first ordering).
PUBLIC_RECORDS_MAX_INPUT_TOKENS=250000

# Standard model mode. 'confidential' (open-weight inference for
# sensitive targets) is a stub that raises NotImplementedError.
PE_RISK_KEY_MODE=standard

# Reserved for the confidential-mode inference provider. Unread until
# confidential mode is wired up.
BASETEN_API_KEY=

# 1 = serve outside-in collectors from fixtures/outside_in/*.json
# instead of the network. Model calls stay live.
DEMO_MODE=1

# Override the runs directory (default eval/runs/). The test suite
# points this at a tmp dir; tests never touch the real eval/runs/.
PE_RISK_KEY_RUNS_DIR=

# 1 = allow scripts/serve.py to bind somewhere other than 127.0.0.1.
# The server refuses non-loopback binds without this.
PE_RISK_KEY_ALLOW_REMOTE=
